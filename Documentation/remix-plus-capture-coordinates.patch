+void validateCaptureInput(const Export& data) {
+  check(!data.instanceStagePath.empty(), "Missing capture output path");
+  check(data.meta.numFramesCaptured > 0 && finite(data.meta.timeCodesPerSecond) && data.meta.timeCodesPerSecond > 0,
+        "Invalid capture timing");
+  check(finite(data.meta.metersPerUnit) && data.meta.metersPerUnit > 0, "Invalid capture scale");
+  check(finite(data.meta.startTimeCode) && finite(data.meta.endTimeCode) && data.meta.endTimeCode >= data.meta.startTimeCode,
+        "Invalid capture time range");
+  check(finiteMatrix(data.globalXform), "Invalid capture global transform");
+  for (const auto& [id, material] : data.materials) { name(material.matName, "Material " + std::to_string(id)); }
+  for (const auto& [id, mesh] : data.meshes) {
+    const auto context = "Mesh " + std::to_string(id) + " (" + mesh.meshName + ")";
+    name(mesh.meshName, context);
+    check(mesh.numVertices > 0 && mesh.numIndices > 0 && mesh.numIndices % 3 == 0, context + ": invalid triangle counts");
+    check(!mesh.buffers.positionBufs.empty() && !mesh.buffers.idxBufs.empty(), context + ": missing geometry buffers");
+    for (const auto& [time, positions] : mesh.buffers.positionBufs) {
+      check(finite(time) && positions.size() == mesh.numVertices, context + ": invalid position count");
+      for (const auto& p : positions) { check(finiteVector<pxr::GfVec3f,3>(p), context + ": invalid position"); }
+    }
+    for (const auto& [time, indices] : mesh.buffers.idxBufs) {
+      check(finite(time) && indices.size() == mesh.numIndices, context + ": invalid index count");
+      for (auto index : indices) { check(index >= 0 && uint32_t(index) < mesh.numVertices, context + ": index out of range"); }
+    }
+    for (const auto& [time, normals] : mesh.buffers.normalBufs) {
+      check(normals.size() == mesh.numVertices, context + ": invalid normal count");
+      for (const auto& n : normals) { check(finiteVector<pxr::GfVec3f,3>(n), context + ": invalid normal"); }
+    }
+    for (const auto& [time, uv] : mesh.buffers.texcoordBufs) {
+      check(uv.size() == mesh.numVertices, context + ": invalid texcoord count");
+      for (const auto& v : uv) { check(finiteVector<pxr::GfVec2f,2>(v), context + ": invalid texcoord"); }
+    }
+    for (const auto& [time, colors] : mesh.buffers.colorBufs) {
+      check(colors.size() == 1 || colors.size() == mesh.numVertices, context + ": invalid color count");
+      for (const auto& c : colors) { check(finiteVector<pxr::GfVec4f,4>(c), context + ": invalid color"); }
+    }
+    check(mesh.matId == kInvalidId || data.materials.count(mesh.matId), context + ": missing material");
+    if (mesh.numBones) {
+      check(mesh.bonesPerVertex > 0 && mesh.bonesPerVertex <= mesh.numBones, context + ": invalid bone stride");
+      const auto count = size_t(mesh.numVertices) * mesh.bonesPerVertex;
+      for (const auto& [time, weights] : mesh.buffers.blendWeightBufs) {
+        check(weights.size() == count, context + ": invalid weight count"); finiteArray(weights, context);
+        for (auto weight : weights) { check(weight >= 0, context + ": negative weight"); }
+      }
+      for (const auto& [time, indices] : mesh.buffers.blendIndicesBufs) {
+        check(indices.size() == count, context + ": invalid joint-index count");
+        for (auto i : indices) { check(i >= 0 && uint32_t(i) < mesh.numBones, context + ": joint index out of range"); }
+      }
+    }
+  }
+  for (const auto& [id, instance] : data.instances) {
+    const auto context = "Instance " + std::to_string(id) + " (" + instance.instanceName + ")";
+    name(instance.instanceName, context); samples(instance.xforms, context); span(instance.firstTime, instance.finalTime, context);
+    check(data.meshes.count(instance.meshId), context + ": missing mesh");
+    check(instance.matId == kInvalidId || data.materials.count(instance.matId), context + ": missing material");
+    const auto bones = data.meshes.at(instance.meshId).numBones;
+    for (const auto& pose : instance.boneXForms) {
+      check(pose.xforms.size() == bones, context + ": invalid pose size");
+      for (const auto& matrix : pose.xforms) { check(finiteMatrix(matrix), context + ": invalid pose matrix"); }
+    }
+  }
+  if (!data.camera.xforms.empty()) {
+    samples(data.camera.xforms, "Camera");
+    check(finite(data.camera.fov) && data.camera.fov > 0 && data.camera.fov < 3.141593f &&
+          finite(data.camera.aspectRatio) && data.camera.aspectRatio > 0 && finite(data.camera.nearPlane) &&
+          finite(data.camera.farPlane) && data.camera.nearPlane > 0 && data.camera.farPlane > data.camera.nearPlane,
+          "Invalid capture camera");
+  }
+  for (const auto& [id, light] : data.sphereLights) {
+    const auto context = "Light " + std::to_string(id) + " (" + light.lightName + ")";
+    check(int(light.kind) >= 0 && int(light.kind) <= int(AreaLightKind::Cylinder), context + ": invalid light type");
+    name(light.lightName, context); samples(light.xforms, context); span(light.firstTime, light.finalTime, context);
+    check(finite(light.intensity) && light.intensity >= 0 && finite(light.radius) && light.radius >= 0 &&
+          finite(light.width) && light.width > 0 && finite(light.height) && light.height > 0, context + ": invalid dimensions/intensity");
+    for (float c : light.color) { check(finite(c) && c >= 0, context + ": invalid color"); }
+    check(finite(light.coneAngleDegrees) && finite(light.coneSoftness) && finite(light.focusExponent), context + ": invalid shaping");
+  }
+  for (const auto& [id, light] : data.distantLights) {
+    const auto context = "Distant light " + std::to_string(id);
+    name(light.lightName, context); span(light.firstTime, light.finalTime, context);
+    check(finite(light.intensity) && light.intensity >= 0 && finite(light.angleDegrees) && light.angleDegrees >= 0 &&
+          finiteVector<pxr::GfVec3f,3>(light.direction) && light.direction.GetLengthSq() > 0, context + ": invalid parameters");
+    for (float c : light.color) { check(finite(c) && c >= 0, context + ": invalid color"); }
+  }
+}
+
+bool GameExporter::validateUsd(const std::string& path, std::string* error) {
+  try {
+    pxr::TfErrorMark diagnostics;
+    auto stage = pxr::UsdStage::Open(path);
+    check(bool(stage), "Cannot reopen capture: " + path);
+    check(stage->GetCompositionErrors().empty(), "Capture has composition errors: " + path);
+    check(bool(stage->GetDefaultPrim()), "Capture has no default prim: " + path);
+    for (auto prim : stage->Traverse()) {
+      const auto context = path + ": " + prim.GetPath().GetString();
+      if (prim.IsA<pxr::UsdGeomMesh>()) {
+        auto mesh = pxr::UsdGeomMesh(prim);
+        std::vector<double> times;
+        mesh.GetPointsAttr().GetTimeSamples(&times);
+        if (times.empty()) { times.push_back(0); }
+        for (double time : times) {
+          pxr::VtVec3fArray points; pxr::VtIntArray indices, counts;
+          check(mesh.GetPointsAttr().Get(&points, time) && mesh.GetFaceVertexIndicesAttr().Get(&indices, time) &&
+                mesh.GetFaceVertexCountsAttr().Get(&counts, time), context + ": unreadable topology");
+          size_t total = 0;
+          for (auto count : counts) { check(count >= 3, context + ": invalid face"); total += count; }
+          check(total == indices.size(), context + ": inconsistent topology");
+          for (auto i : indices) { check(i >= 0 && size_t(i) < points.size(), context + ": index out of range"); }
+          for (const auto& p : points) { check(finiteVector<pxr::GfVec3f,3>(p), context + ": non-finite point"); }
+        }
+      }
+      if (prim.IsA<pxr::UsdSkelSkeleton>()) {
+        auto skeleton = pxr::UsdSkelSkeleton(prim);
+        pxr::VtTokenArray joints; pxr::VtMatrix4dArray bind, rest;
+        check(skeleton.GetJointsAttr().Get(&joints) && skeleton.GetBindTransformsAttr().Get(&bind) &&
+              skeleton.GetRestTransformsAttr().Get(&rest) && !joints.empty() && joints.size() == bind.size() &&
+              bind.size() == rest.size(), context + ": inconsistent skeleton");
+      }
+      for (auto attr : prim.GetAttributes()) {
+        std::vector<double> times; attr.GetTimeSamples(&times);
+        std::vector<pxr::UsdTimeCode> codes{pxr::UsdTimeCode::Default()};
+        for (auto time : times) { codes.emplace_back(time); }
+        for (auto code : codes) {
+          pxr::VtValue value;
+          if (!attr.Get(&value, code) || value.IsEmpty()) { continue; }
+          if (value.IsHolding<float>()) { check(finite(value.UncheckedGet<float>()), context + ": non-finite attribute " + attr.GetName().GetString()); }
+          if (value.IsHolding<double>()) { check(finite(value.UncheckedGet<double>()), context + ": non-finite attribute"); }
+          if (value.IsHolding<pxr::GfVec3f>()) { check(finiteVector<pxr::GfVec3f,3>(value.UncheckedGet<pxr::GfVec3f>()), context + ": non-finite vector"); }
+          if (value.IsHolding<pxr::GfMatrix4d>()) { check(finiteMatrix(value.UncheckedGet<pxr::GfMatrix4d>()), context + ": non-finite matrix"); }
+          if (value.IsHolding<pxr::VtFloatArray>()) { finiteArray(value.UncheckedGet<pxr::VtFloatArray>(), context); }
+          if (value.IsHolding<pxr::VtVec3fArray>()) {
+            for (const auto& v : value.UncheckedGet<pxr::VtVec3fArray>()) { check(finiteVector<pxr::GfVec3f,3>(v), context + ": non-finite vector array " + attr.GetName().GetString()); }
+          }
+          if (value.IsHolding<pxr::VtMatrix4dArray>()) {
+            for (const auto& m : value.UncheckedGet<pxr::VtMatrix4dArray>()) { check(finiteMatrix(m), context + ": non-finite matrix array"); }
+          }
+          if (value.IsHolding<pxr::SdfAssetPath>()) {
+            const auto& asset = value.UncheckedGet<pxr::SdfAssetPath>();
+            check(asset.GetAssetPath().empty() || !asset.GetResolvedPath().empty(), context + ": unresolved asset " + asset.GetAssetPath());
+          }
+        }
+      }
+      for (auto rel : prim.GetRelationships()) {
+        if (rel.GetName() != pxr::TfToken("skel:skeleton") && rel.GetName() != pxr::TfToken("skel:animationSource")) { continue; }
+        if (!rel.HasAuthoredTargets()) { continue; }
+        pxr::SdfPathVector targets; check(rel.GetTargets(&targets), context + ": unreadable binding");
+        for (const auto& target : targets) { check(bool(stage->GetPrimAtPath(target)), context + ": missing binding target " + target.GetString()); }
+      }
+    }
+    checkCaptureDiagnostics(diagnostics, "validate scene " + path);
+    return true;
+  } catch (const std::exception& failure) {
+    if (error) { *error = failure.what(); }
+    return false;
+  }
+}
+
+void validateCaptureCounts(const std::string& path, const Export& data) {
+  auto stage = pxr::UsdStage::Open(path);
+  size_t lights = 0, instances = 0;
+  for (auto prim : stage->Traverse()) {
+    if (prim.HasAPI<pxr::UsdLuxLightAPI>() && prim.GetPath().HasPrefix(gRootLightsPath) && prim.GetName() != pxr::TfToken("SkyDome_Non_Replaceable")) { ++lights; }
+    if (prim.GetPath().GetParentPath() == gRootInstancesPath) { ++instances; }
+  }
+  check(lights == data.sphereLights.size() + data.distantLights.size(), "Capture light count mismatch");
+  check(instances == data.instances.size(), "Capture instance count mismatch");
+}
+
+bool GameExporter::flattenUsd(const std::string& source, const std::string& destination, std::string* error) {
+  auto final = std::filesystem::u8path(destination);
+  auto temporary = std::filesystem::u8path(destination + ".building.usd");
+  try {
+    check(!std::filesystem::exists(final) && !std::filesystem::exists(temporary), "Flatten destination already exists");
+    pxr::TfErrorMark diagnostics;
+    auto stage = pxr::UsdStage::Open(source);
+    check(bool(stage), "Cannot reopen capture for flattening");
+    check(stage->Export(temporary.u8string(), true), "Cannot write flattened capture");
+    checkCaptureDiagnostics(diagnostics, "flatten capture");
+    std::string validation;
+    check(validateUsd(temporary.u8string(), &validation), validation);
+    std::filesystem::rename(temporary, final);
+    return true;
+  } catch (const std::exception& failure) {
+    std::error_code ignored;
+    if (std::filesystem::exists(temporary, ignored)) {
+      std::filesystem::rename(temporary, std::filesystem::u8path(temporary.u8string() + ".failed"), ignored);
+    }
+    if (error) { *error = failure.what(); }
+    return false;
+  }
+}
+}
