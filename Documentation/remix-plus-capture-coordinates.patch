+namespace lss {
+inline std::filesystem::path captureInputDirectory(const std::string& base, const std::string& id) {
+  if (id.empty() || id.size() > 128 || id.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_") != std::string::npos) {
+    throw std::runtime_error("Invalid capture input directory ID");
+  }
+  return std::filesystem::u8path(base) / (".capture-input-" + id);
+}
+inline std::string captureTextureDirectory(const std::string& base, const std::string& id) {
+  return (captureInputDirectory(base, id) / "textures").u8string() + "/";
+}
+inline void cleanupCaptureInputs(const std::string& base, const std::string& id) {
+  const auto inputs = captureInputDirectory(base, id);
+  const auto root = std::filesystem::weakly_canonical(std::filesystem::u8path(base));
+  const auto resolved = std::filesystem::weakly_canonical(inputs);
+  if (std::filesystem::is_symlink(inputs) || resolved.parent_path() != root || resolved.filename() != inputs.filename()) {
+    throw std::runtime_error("Capture input cleanup escaped its root");
+  }
+  std::filesystem::remove_all(inputs);
+}
+// Untextured draws use a neutral texture. Missing requested textures still fail.
+inline void writeCaptureWhiteTexture(const std::string& path) {
+  uint32_t dds[33]{};
+  dds[0] = 0x20534444; dds[1] = 124; dds[2] = 0x100f;
+  dds[3] = dds[4] = 1; dds[5] = 4;
+  dds[19] = 32; dds[20] = 0x41; dds[22] = 32;
+  dds[23] = 0xff0000; dds[24] = 0xff00; dds[25] = 0xff; dds[26] = 0xff000000;
+  dds[27] = 0x1000; dds[32] = 0xffffffff;
+  std::ofstream file(std::filesystem::u8path(path), std::ios::binary);
+  file.write(reinterpret_cast<const char*>(dds), sizeof(dds));
+  file.close();
+  if (!file) { throw std::runtime_error("Cannot write untextured capture material: " + path); }
+}
+}
