+        foundLight = true;
+      } else if (prim.IsA<pxr::UsdGeomCamera>()) {
+        const pxr::UsdGeomCamera usdCamera(prim);
+        check(usdCamera.ComputeLocalToWorldTransform(sample) == pose, "Captured camera pose changed");
+        foundCamera = true;
+      }
+    }
+    check(foundMesh && foundLight && foundCamera, "The published capture is missing scene content");
+  }
+  Logger::info("testCaptureCoordinates passed");
+}
