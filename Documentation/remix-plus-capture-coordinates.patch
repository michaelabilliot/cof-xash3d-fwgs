+void repairCaptureNormals(Export& data) {
+  for (auto& [id, mesh] : data.meshes) {
+    for (auto& [time, normals] : mesh.buffers.normalBufs) {
+      size_t invalid = 0;
+      for (const auto& n : normals) { if (!finiteVector<pxr::GfVec3f,3>(n)) { ++invalid; } }
+      if (!invalid) { continue; }
+      const auto context = "Mesh " + std::to_string(id) + " (" + mesh.meshName + ")";
+      check(finite(time), context + ": invalid normal sample time");
+      check(normals.size() == mesh.numVertices && !mesh.buffers.positionBufs.empty() && !mesh.buffers.idxBufs.empty(), context + ": cannot reconstruct normals without complete geometry");
+      auto positionsAt = mesh.buffers.positionBufs.upper_bound(time);
+      if (positionsAt != mesh.buffers.positionBufs.begin()) { --positionsAt; }
+      auto indicesAt = mesh.buffers.idxBufs.upper_bound(time);
+      if (indicesAt != mesh.buffers.idxBufs.begin()) { --indicesAt; }
+      const auto& positions = positionsAt->second;
+      const auto& indices = indicesAt->second;
+      check(positions.size() == normals.size() && indices.size() % 3 == 0, context + ": cannot reconstruct invalid normal topology");
+      for (const auto& p : positions) { check(finiteVector<pxr::GfVec3f,3>(p), context + ": cannot reconstruct normals from non-finite positions"); }
+      std::vector<pxr::GfVec3d> sums(positions.size(), pxr::GfVec3d(0));
+      std::vector<pxr::GfVec3d> incident(positions.size(), pxr::GfVec3d(0));
+      std::vector<bool> used(positions.size(), false);
+      pxr::GfVec3d sourceFallback(0);
+      for (const auto& n : normals) {
+        if (!finiteVector<pxr::GfVec3f,3>(n)) { continue; }
+        const pxr::GfVec3d candidate(n);
+        const auto length = candidate.GetLength();
+        if (finite(length) && length > 0) { sourceFallback = candidate / length; break; }
+      }
+      for (size_t i = 0; i < indices.size(); i += 3) {
+        const auto a = indices[i], b = indices[i+1], c = indices[i+2];
+        check(a >= 0 && b >= 0 && c >= 0 && size_t(a) < positions.size() && size_t(b) < positions.size() && size_t(c) < positions.size(), context + ": index out of range during normal reconstruction");
+        const auto face = pxr::GfCross(pxr::GfVec3d(positions[b]) - pxr::GfVec3d(positions[a]), pxr::GfVec3d(positions[c]) - pxr::GfVec3d(positions[a]));
+        sums[a] += face; sums[b] += face; sums[c] += face;
+        if (finite(face.GetLength()) && face.GetLength() > 0) {
+          incident[a] = incident[b] = incident[c] = face;
+        }
+        used[a] = used[b] = used[c] = true;
+      }
+      for (size_t i = 0; i < normals.size(); ++i) {
+        if (finiteVector<pxr::GfVec3f,3>(normals[i])) { continue; }
+        if (!used[i] && data.meta.bReduceMeshBuffers) { normals[i] = pxr::GfVec3f(0); continue; }
+        auto replacement = sums[i];
+        if (replacement.GetLength() == 0) { replacement = incident[i]; }
+        // A vertex touching only zero-area faces has no geometric normal.
+        // Reuse a finite authored normal without changing any visible face.
+        if (replacement.GetLength() == 0) { replacement = sourceFallback; }
+        const auto length = replacement.GetLength();
+        check(finite(length) && length > 0, context + ": cannot reconstruct normal on degenerate geometry");
+        normals[i] = pxr::GfVec3f(replacement / length);
+      }
+      dxvk::Logger::warn("[GameExporter][" + data.debugId + "] " + context + ": recovered " + std::to_string(invalid) + " non-finite normals from geometry/finite authored normals");
+    }
+  }
+}
