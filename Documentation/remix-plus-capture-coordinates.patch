+        usdMesh.GetFaceVertexIndicesAttr().Get(&indices, sample);
+        check(points.size() == 3 && normals.size() == 3 && indices.size() == 3, "Missing triangle data");
+        const auto p0 = transform.Transform(GfVec3d(points[indices[0]]));
+        const auto p1 = transform.Transform(GfVec3d(points[indices[1]]));
+        const auto p2 = transform.Transform(GfVec3d(points[indices[2]]));
+        check(p0 == objectPosition && p1 == objectPosition + GfVec3d(4, 0, 0) &&
+              p2 == objectPosition + GfVec3d(1, 2, 0) &&
+              pxr::GfDot(pxr::GfCross(p1 - p0, p2 - p0), transform.TransformDir(GfVec3d(normals[0]))) > 0,
+              "Floor axes, instance position, normal or winding changed");
+        foundMesh = true;
+      } else if (prim.IsA<pxr::UsdLuxSphereLight>()) {
+        const pxr::UsdGeomXformable usdLight(prim);
+        check(usdLight.ComputeLocalToWorldTransform(sample).ExtractTranslation() == lightPosition,
