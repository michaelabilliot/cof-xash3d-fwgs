@@ -85,9 +85,35 @@ struct Camera {
   } view, proj;
   // Do XOR here to check if we need to manually change basis for Projection * View matrix
   inline bool isLHS() const { return view.isLHS() ^ proj.isLHS(); }
+
+  // The view basis and the projection's choice of forward axis describe
+  // world handedness together. A reflected view with +Z forward can be RHS.
+  pxr::GfMatrix4d worldBasis() const {
+    const bool invertX = !view.bInv && (proj.bInv || isLHS());
+    const bool invertY = !view.bInv && proj.bInv;
+    return pxr::GfMatrix4d(1.0).SetScale(pxr::GfVec3d(invertX ? -1.0 : 1.0, invertY ? -1.0 : 1.0, 1.0));
+  }
+
+  pxr::GfMatrix4d usdCameraTransform(pxr::GfVec3d position, pxr::GfVec3d direction, pxr::GfVec3d up) const {
+    const auto basis = worldBasis();
+    position = basis.Transform(position);
+    direction = basis.TransformDir(direction);
+    up = basis.TransformDir(view.bInv ? -up : up);
+    pxr::GfMatrix4d worldToView;
+    worldToView.SetLookAt(position, position + direction, up);
+    worldToView.Orthonormalize();
+    return worldToView.GetInverse();
+  }
+
+  bool reverseWinding(bool sourceFacingFlipped) const {
+    return sourceFacingFlipped ^ (worldBasis().GetDeterminant3() < 0.0);
+  }
 };
 
