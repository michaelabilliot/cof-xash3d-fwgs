+static void testCaptureCoordinates() {
+  using pxr::GfMatrix4d;
+  using pxr::GfVec3d;
+  const auto check = [](bool condition, const char* message) {
+    if (!condition) {
+      throw DxvkError(message);
+    }
+  };
+  const GfMatrix4d identity(1.0);
+  const GfVec3d eye(11, 12, 13), forward(0, 1, 0), up(0, 0, 1), right(1, 0, 0);
+  lss::Camera camera;
+  camera.view.coord = lss::LHS;
+  camera.proj.coord = lss::LHS;
+  check(camera.worldBasis() == identity, "Xash's view reflection cancels its +Z projection convention");
+  const auto pose = camera.usdCameraTransform(eye, forward, up);
+  check(pose.ExtractTranslation() == eye && pose.TransformDir(GfVec3d(0, 0, -1)) == forward &&
+        pose.TransformDir(GfVec3d(0, 1, 0)) == up && pose.TransformDir(GfVec3d(1, 0, 0)) == right &&
+        pose.GetDeterminant3() == 1.0, "USD camera has the wrong pose or handedness");
+  camera.view.coord = lss::RHS;
+  check(camera.worldBasis().GetDeterminant3() == -1.0 && camera.reverseWinding(false),
+        "A left-handed world needs one reflection and one winding reversal");
+  camera.proj.bInv = true;
+  check(camera.worldBasis().GetDeterminant3() == 1.0 && !camera.reverseWinding(false),
+        "Two world-axis flips preserve handedness");
+  camera.proj.bInv = false;
+  camera.proj.coord = lss::RHS;
+  check(camera.worldBasis() == identity, "Ordinary RHS view/projection should preserve the world");
+
+  const auto folder = std::filesystem::temp_directory_path() /
+    ("remix-coordinate-test-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+  std::filesystem::create_directory(folder);
+  struct Cleanup {
+    std::filesystem::path path;
+    ~Cleanup() { std::error_code ignored; std::filesystem::remove_all(path, ignored); }
+  } cleanup{folder};
+
+  for (bool zUp : {true, false}) {
+    lss::Export capture{};
+    capture.debugId = "test-capture-coordinates";
+    capture.bExportInstanceStage = true;
+    capture.instanceStagePath = (folder / (zUp ? "z-up.usd" : "y-up.usd")).u8string();
+    capture.meta.isZUp = zUp;
+    capture.meta.metersPerUnit = 0.0254;
+    capture.meta.timeCodesPerSecond = 24;
+    capture.meta.numFramesCaptured = 2;
+    capture.meta.endTimeCode = 1;
+    capture.camera = camera;
+    capture.camera.fov = 1.0f;
+    capture.camera.aspectRatio = 1.5f;
+    capture.camera.nearPlane = 1.0f;
+    capture.camera.farPlane = 1000.0f;
+    capture.camera.firstTime = 0.0f;
+    capture.camera.finalTime = 1.0f;
+    capture.camera.xforms.push_back({0, pose});
+    capture.camera.xforms.push_back({1, pose});
+    capture.globalXform = camera.worldBasis();
+    const GfVec3d objectPosition(3, 7, 0), lightPosition(13, 21, 34);
+    auto& mesh = capture.meshes[1];
+    mesh.meshName = "0000000000000001";
+    mesh.numVertices = mesh.numIndices = 3;
+    mesh.buffers.positionBufs[0] = {{0, 0, 0}, {4, 0, 0}, {1, 2, 0}};
+    mesh.buffers.normalBufs[0] = {{0, 0, 1}, {0, 0, 1}, {0, 0, 1}};
+    mesh.buffers.idxBufs[0] = {0, 1, 2};
+    auto& instance = capture.instances[2];
+    instance.instanceName = "0000000000000002";
+    instance.meshId = 1;
+    instance.firstTime = 0;
+    instance.finalTime = 1;
+    instance.xforms.push_back({0, GfMatrix4d(1.0).SetTranslate(objectPosition)});
+    auto& light = capture.sphereLights[3];
+    light.lightName = "0000000000000003";
+    light.color[0] = light.color[1] = light.color[2] = 1.0f;
+    light.intensity = light.radius = 1.0f;
+    light.firstTime = 0;
+    light.finalTime = 1;
+    light.xforms.push_back({0, GfMatrix4d(1.0).SetTranslate(lightPosition)});
+    std::string error;
+    const bool saved = lss::GameExporter::exportUsd(capture, &error);
+    if (!saved) {
+      throw DxvkError(error.c_str());
+    }
+    const auto stage = pxr::UsdStage::Open(capture.instanceStagePath);
+    check(bool(stage), "Could not reopen the public capture");
+    check(stage->HasAuthoredMetadata(pxr::TfToken("upAxis")) &&
+          pxr::UsdGeomGetStageUpAxis(stage) == (zUp ? pxr::UsdGeomTokens->z : pxr::UsdGeomTokens->y) &&
+          pxr::UsdGeomGetStageMetersPerUnit(stage) == capture.meta.metersPerUnit &&
+          stage->GetTimeCodesPerSecond() == 24 && stage->GetEndTimeCode() == 1,
+          "Public capture lost its stage metrics or playback range");
+    bool foundMesh = false, foundLight = false, foundCamera = false;
+    const pxr::UsdTimeCode sample(0);
+    for (const auto& prim : stage->Traverse()) {
+      const auto path = prim.GetPath().GetString();
+      if (prim.IsA<pxr::UsdGeomMesh>() && path.find("/instances/") != std::string::npos) {
+        const pxr::UsdGeomMesh usdMesh(prim);
+        const auto transform = usdMesh.ComputeLocalToWorldTransform(sample);
+        pxr::VtVec3fArray points, normals;
+        pxr::VtIntArray indices;
