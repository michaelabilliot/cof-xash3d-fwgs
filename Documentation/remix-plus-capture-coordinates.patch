diff --git a/src/dxvk/rtx_render/rtx_capture_jobs.h b/src/dxvk/rtx_render/rtx_capture_jobs.h
new file mode 100644
index 00000000..859db036
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_capture_jobs.h
@@ -0,0 +1,94 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+
+namespace dxvk {
+// One batch belongs to one capture, independent of later exporter submissions.
+class CaptureJobs {
+public:
+  uint64_t begin(const std::string& label) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const auto id = ++m_next;
+    m_pending.emplace(id, label);
+    return id;
+  }
+  void finish(uint64_t id, const std::string& failure) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!failure.empty() && m_error.empty()) { m_error = failure; }
+    m_pending.erase(id);
+    m_changed.notify_all();
+  }
+  void fail(const std::string& failure) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_error.empty()) { m_error = failure; }
+  }
+  void cancel() { m_cancelled.store(true); m_changed.notify_all(); }
+  bool cancelled() const { return m_cancelled.load(); }
+  void wait(std::chrono::milliseconds timeout) {
+    std::unique_lock<std::mutex> lock(m_mutex);
+    if (!m_changed.wait_for(lock, timeout, [&] { return m_pending.empty() || cancelled(); })) {
+      std::string detail = "Capture preparation timed out; outstanding jobs: " + std::to_string(m_pending.size());
+      size_t shown = 0;
+      for (const auto& [id, label] : m_pending) { if (shown++ == 8) { break; } detail += "\n" + label; }
+      m_cancelled.store(true);
+      throw std::runtime_error(detail);
+    }
+    if (cancelled()) { throw std::runtime_error("Capture cancelled"); }
+    if (!m_error.empty()) { throw std::runtime_error(m_error); }
+  }
+  void drain() {
+    std::unique_lock<std::mutex> lock(m_mutex);
+    m_changed.wait(lock, [&] { return m_pending.empty(); });
+  }
+private:
+  std::mutex m_mutex;
+  std::condition_variable m_changed;
+  std::map<uint64_t, std::string> m_pending;
+  std::string m_error;
+  uint64_t m_next = 0;
+  std::atomic<bool> m_cancelled{false};
+};
+
+class CaptureJob {
+public:
+  CaptureJob(std::atomic<uint64_t>& counter, std::shared_ptr<CaptureJobs> batch, std::string label)
+    : m_counter(counter), m_batch(std::move(batch)), m_label(std::move(label)) {
+    if (m_batch) { m_id = m_batch->begin(m_label); }
+    ++m_counter;
+  }
+  ~CaptureJob() {
+    if (m_batch) { m_batch->finish(m_id, m_finished ? m_error : m_label + ": task did not complete (queue rejection or submission failure)"); }
+    --m_counter;
+  }
+  template<class Fn> void run(Fn&& operation) noexcept {
+    try { operation(); m_finished = true; }
+    catch (const std::exception& error) { fail(error.what()); }
+    catch (...) { fail("Unknown asset-export exception"); }
+  }
+  void fail(const std::string& error) { m_error = m_label + ": " + error; m_finished = true; }
+  const std::string& error() const { return m_error; }
+  template<class Ready> void waitReadback(Ready&& ready, std::chrono::milliseconds timeout = std::chrono::seconds(120)) {
+    const auto deadline = std::chrono::steady_clock::now() + timeout;
+    while (!ready()) {
+      if (m_batch && m_batch->cancelled()) { throw std::runtime_error("Readback cancelled"); }
+      if (std::chrono::steady_clock::now() >= deadline) { throw std::runtime_error("GPU readback timed out"); }
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    if (m_batch && m_batch->cancelled()) { throw std::runtime_error("Readback cancelled"); }
+  }
+private:
+  std::atomic<uint64_t>& m_counter;
+  std::shared_ptr<CaptureJobs> m_batch;
+  std::string m_label, m_error;
+  uint64_t m_id = 0;
+  bool m_finished = false;
+};
+}
