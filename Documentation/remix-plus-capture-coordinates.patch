+void check(bool valid, const std::string& context) {
+  if (!valid) { throw std::runtime_error(context); }
+}
+template<class T> bool finite(const T& value) { return std::isfinite(double(value)); }
+template<class T, size_t N> bool finiteVector(const T& value) {
+  for (size_t i = 0; i < N; ++i) { if (!finite(value[i])) { return false; } }
+  return true;
+}
+bool finiteMatrix(const pxr::GfMatrix4d& m) {
+  for (size_t i = 0; i < 4; ++i) {
+    for (size_t j = 0; j < 4; ++j) { if (!finite(m[i][j])) { return false; } }
+  }
+  return true;
+}
+void samples(const SampledXforms& xforms, const std::string& context) {
+  check(!xforms.empty(), context + ": no transforms");
+  for (const auto& x : xforms) {
+    check(finite(x.time) && finiteMatrix(x.xform), context + ": invalid transform sample");
+  }
+}
+void name(const std::string& value, const std::string& context) {
+  check(pxr::SdfPath::IsValidIdentifier("asset_" + value), context + ": invalid name " + value);
+}
+void span(float first, float last, const std::string& context) {
+  check(finite(first) && finite(last) && first >= 0 && last >= first, context + ": invalid time span");
+}
+template<class T> void finiteArray(const pxr::VtArray<T>& values, const std::string& context) {
+  for (const auto& value : values) { check(finite(value), context + ": non-finite array"); }
+}
+}
+
+void checkCaptureDiagnostics(pxr::TfErrorMark& diagnostics, const std::string& phase) {
+  if (!diagnostics.IsClean()) {
+    std::string message = phase;
+    for (const auto& error : diagnostics) { message += "\n" + error.GetCommentary(); }
+
+    diagnostics.Clear();
+    throw std::runtime_error(message);
+  }
+}
