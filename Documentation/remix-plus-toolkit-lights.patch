+  void LightManager::resolveExternalLights(AssetReplacer& replacer) {
+    m_resolvedExternalLights.clear();
+    for (const auto handle : m_externalActiveLightList) {
+      auto& source = m_externalLights.at(handle);
+      const bool supported = source.getType() == RtLightType::Sphere ||
+                             source.getType() == RtLightType::Distant;
+      const auto bucket = supported ? replacer.getReplacementsForLight(source.getInitialHash()) : nullptr;
+      auto previous = m_externalLightReplacements.find(handle);
+      const bool logDecision = Logger::logLevel() <= LogLevel::Debug;
+      if (!bucket) {
+        if (logDecision) {
+          const auto p = source.getPosition();
+          Logger::debug(str::format("[ExternalLight] hash=", hashToString(source.getInitialHash()),
+            " position=", p.x, ",", p.y, ",", p.z, " state=unmatched (original submitted)"));
+        }
+        if (previous != m_externalLightReplacements.end()) {
+          m_externalLightReplacements.erase(previous);
+        }
+        m_resolvedExternalLights.push_back(&source);
+        continue;
+      }
+
+      // A present bucket owns the source even when empty or all entries are dark.
+      source.setBufferIdx(kNewLightIdx);
+      auto& entry = m_externalLightReplacements[handle];
+      if (entry.bucket != bucket) {
+        entry.bucket = bucket;
+        entry.lights.clear();
+        entry.lights.reserve(bucket->replacements.size());
+      }
+      size_t slot = 0;
+      bool emits = false;
+      for (const auto& replacement : bucket->replacements) {
+        if (replacement.type != AssetReplacement::eLight || !replacement.lightData) {
+          continue;
+        }
+        auto data = *replacement.lightData;
+        data.merge(source);
+        auto light = data.toRtLight();
+        if (data.relativeTransform()) {
+          light.applyTransform(LightData::getSourceTransform(source));
+        }
+        light.isDynamic = source.isDynamic;
+        light.ignoreViewModel = source.ignoreViewModel;
+        if (slot == entry.lights.size()) {
+          entry.lights.push_back(light);
+        } else {
+          auto& existing = entry.lights[slot];
+          light.setStableIdentity(existing.getStableIdentity());
+          light.setBufferIdx(existing.getBufferIdx());
+          existing = light;
+        }
+        m_resolvedExternalLights.push_back(&entry.lights[slot++]);
+        emits |= logDecision && light.getColorAndIntensity().w > 0.f;
+      }
+      if (logDecision) {
+        const auto p = source.getPosition();
+        Logger::debug(str::format("[ExternalLight] hash=", hashToString(source.getInitialHash()),
+          " position=", p.x, ",", p.y, ",", p.z, " state=", emits ? "replaced" : "suppressed"));
+      }
+    }
+    for (auto it = m_externalLightReplacements.begin(); it != m_externalLightReplacements.end();) {
+      if (m_externalActiveLightList.count(it->first) == 0) {
+        it = m_externalLightReplacements.erase(it);
+      } else {
+        ++it;
+      }
+    }
+  }
