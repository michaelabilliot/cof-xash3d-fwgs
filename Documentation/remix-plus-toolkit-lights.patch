+  Matrix4 LightData::getSourceTransform(const RtLight& light) {
+    const auto position = light.getPosition();
+    if (light.getType() == RtLightType::Sphere) {
+      const auto& shaping = light.getSphereLight().getShaping();
+      if (!shaping.getEnabled()) {
+        return Matrix4(position);
+      }
+      return Matrix4(getOrientation(Vector3(0.f, 0.f, -1.f), shaping.getDirection()), position);
+    }
+    if (light.getType() == RtLightType::Distant) {
+      return Matrix4(getOrientation(Vector3(0.f, 0.f, -1.f), light.getDirection()), position);
+    }
+    return Matrix4(position);
+  }
+
+  void LightData::merge(const RtLight& light) {
+    // Sphere and distant are the analytic source types supported by legacy
+    // capture and by the map-light API bridge.
+    const bool isSphere = light.getType() == RtLightType::Sphere;
+    const auto sourceType = isSphere ? Sphere : Distant;
+    LightData input(sourceType);
+    const Vector4 colorAndIntensity = light.getColorAndIntensity();
+    input.m_Color = Vector3(colorAndIntensity.x, colorAndIntensity.y, colorAndIntensity.z);
+    input.m_Intensity = colorAndIntensity.w;
+    input.m_VolumetricRadianceScale = light.getVolumetricRadianceScale();
+    if (!relativeTransform()) {
+      const auto transform = getSourceTransform(light);
+      input.m_position = light.getPosition();
+      input.m_xAxis = Vector3(transform[0][0], transform[0][1], transform[0][2]);
+      input.m_yAxis = Vector3(transform[1][0], transform[1][1], transform[1][2]);
+      input.m_zAxis = -Vector3(transform[2][0], transform[2][1], transform[2][2]);
+    }
+    if (isSphere) {
+      const auto& sphere = light.getSphereLight();
+      input.m_Radius = sphere.getRadius();
+      const auto& shaping = sphere.getShaping();
+      if (shaping.getEnabled()) {
+        input.m_ConeAngleRadians = std::acos(std::clamp(shaping.getCosConeAngle(), -1.f, 1.f));
+        input.m_ConeSoftness = shaping.getConeSoftness();
+        input.m_Focus = shaping.getFocusExponent();
+      }
+    } else {
+      input.m_AngleRadians = light.getDistantLight().getHalfAngle() * 2.f;
+    }
+    if (m_lightType == Unknown) {
+      m_lightType = sourceType;
+    }
+    merge(input);
+  }
