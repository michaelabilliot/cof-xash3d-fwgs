 // ─── Test: adding a light prim dirties its light hash ────────────────────────
+static void testExternalLightOverride() {
+  const auto stage = pxr::UsdStage::CreateInMemory();
+  const auto prim = stage->OverridePrim(pxr::SdfPath("/RootNode/lights/light_0000000000ABCDEF"));
+  const auto intensity = prim.CreateAttribute(pxr::TfToken("inputs:intensity"), pxr::SdfValueTypeNames->Float);
+  const auto makeSource = [](float brightness) {
+    return RtLight(RtSphereLight(Vector3(12.f, 30.f, 45.f), Vector3(brightness, brightness * .5f, 0.f),
+      8.f, RtLightShaping(true, Vector3(1.f, 0.f, 0.f), .5f, .1f, 1.f), 1.f));
+  };
+  const auto source = makeSource(20.f);
+  const auto brighter = makeSource(80.f);
+  if (source.getInitialHash() != brighter.getInitialHash() ||
+      source.getInitialHash() != source.getSphereLight().getHash()) {
+    throw DxvkError("The captured sphere hash must survive API brightness updates");
+  }
+  for (const float authored : { 0.f, 3.f, 0.f }) {
+    intensity.Set(authored);
+    auto data = LightData::tryCreate(prim, nullptr, true, false);
+    if (!data) {
+      throw DxvkError("Could not load an untyped Toolkit light override");
+    }
+    data->merge(source);
+    const auto light = data->toRtLight();
+    const auto& sphere = light.getSphereLight();
+    const auto color = light.getColorAndIntensity();
+    if (color.w != authored || sphere.getRadius() != 8.f ||
+        length(light.getPosition() - source.getPosition()) > .001f ||
+        length(sphere.getShaping().getDirection() - Vector3(1.f, 0.f, 0.f)) > .001f ||
+        std::abs(sphere.getShaping().getCosConeAngle() - .5f) > .001f) {
+      throw DxvkError("External light override did not preserve its unedited geometry or honor intensity");
+    }
+  }
+  if (source.getColorAndIntensity().w != 20.f) {
+    throw DxvkError("A replacement modified the original API definition");
+  }
+  Logger::info("testExternalLightOverride passed");
+}
